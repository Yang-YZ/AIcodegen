{
  "pipeline": {
    "name": "AI Coding Agent Pipeline",
    "version": "1.0.0",
    "description": "Automated pipeline for implementing AI ideas using coding agents"
  },
  "ai_provider": {
    "primary": "openai",
    "fallbacks": ["anthropic"],
    "providers": {
      "openai": {
        "models": {
          "planning": "gpt-4o-mini",
          "coding": "gpt-4o"
        },
        "base_url": "https://api.openai.com/v1"
      },
      "anthropic": {
        "models": {
          "planning": "claude-3-5-sonnet-20241022",
          "coding": "claude-3-5-sonnet-20241022"
        },
        "base_url": "https://api.anthropic.com/v1"
      },
      "custom": {
        "enabled": false,
        "name": "Custom Coding Agent",
        "models": {
          "planning": "default",
          "coding": "default"
        },
        "base_url": "",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer"
      }
    }
  },
  "defaults": {
    "ai_model": "gpt-4o-mini",
    "coding_model": "gpt-4o",
    "max_iterations": 3,
    "test_timeout": 300000
  },
  "sources": {
    "github_issues": {
      "enabled": true,
      "labels": ["idea"],
      "state": "open"
    },
    "ai_ideas_file": {
      "enabled": true,
      "path": "AI_IDEAS.md",
      "max_ideas": 3
    }
  },
  "implementation": {
    "output_dir": "implementations",
    "create_issue": true,
    "create_pr": true,
    "run_tests": true
  },
  "agents": {
    "planner": {
      "role": "software architect",
      "temperature": 0.7,
      "max_tokens": 4000
    },
    "coder": {
      "role": "expert developer",
      "temperature": 0.5,
      "max_tokens": 4000
    },
    "tester": {
      "role": "QA engineer",
      "temperature": 0.3,
      "max_tokens": 2000
    }
  },
  "quality_checks": {
    "code_review": true,
    "security_scan": true,
    "lint": true
  }
}